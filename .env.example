####################################################################
# Copy to .env and fill in real values. NEVER commit a real .env.
# Generate APP_KEY with:  php artisan key:generate
####################################################################

APP_NAME="ADR Mediation"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=stack
LOG_LEVEL=error

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ------------------------------------------------------------------
# Session / cache / queue
# ------------------------------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Send the session cookie over HTTPS only.
SESSION_SECURE_COOKIE=true

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------
# API auth (JWT)
# Base64 secret. Generate with:
#   php -r "echo base64_encode(random_bytes(64)), PHP_EOL;"
# ------------------------------------------------------------------
JWT_KEY=
JWT_ALGO=HS512
JWT_ISSUER="${APP_URL}"
JWT_TTL=86400

# ------------------------------------------------------------------
# AWS / S3
# ------------------------------------------------------------------
FILESYSTEM_DRIVER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=

# ------------------------------------------------------------------
# Mail
# ------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Brevo (Sendinblue) transactional email
BREVO_API_KEY=
BREVO_WEB_TOKEN=

# SendGrid
SENDGRID_API_KEY=
SENDGRID_SENDER=
SENDGRID_SENDER_NAME=

# ------------------------------------------------------------------
# SMS — MSG91
# ------------------------------------------------------------------
SMS_AUTH_KEY=
SMS_SENDER_ID=Prsolv
SMS_FLOW_API=
SMS_FLOW_KEY=
MSG91_LOGS_URL=https://api.msg91.com/api/v2/logs

# ------------------------------------------------------------------
# WhatsApp providers
# ------------------------------------------------------------------
# Karix — "<api-key>:<api-secret>", base64 encoded by the app
KARIX_AUTH=
KARIX_SOURCE=
KARIX_API_URL=https://api.karix.io/message/

# Mtalkz
MTALKZ_KEY=
MTALKZ_NUM=
MTALKZ_API_URL=https://rcmapi.instaalerts.zone/services/rcm/sendMessage

# Interakt
INTERAKT_KEY=
INTERAKT_API_URL=https://api.interakt.ai/v1/public/message/

# Internal WhatsApp bot callbacks — use a long random shared secret
WHATSAPP_BOT_AUTH=
WHATSAPP_BOT_REPLY_URL=
WHATSAPP_BOT_CONSENT_REPLY_URL=
WHATSAPP_BOT_LOG_URL=
WHATSAPP_BOT_LOG_URL_MTALKZ=

# ------------------------------------------------------------------
# IVR (outbound call) service — use a long random shared secret
# ------------------------------------------------------------------
IVR_AUTH=
IVR_API_URL=
IVR_TRACK_URL=
IVR_RESPONDENT_ID=
IVR_CLAIMANT_ID=

# ------------------------------------------------------------------
# Zoom (Server-to-Server OAuth)
# ------------------------------------------------------------------
ZOOM_API_KEY=
ZOOM_API_SECRET=
ZOOM_OAUTH_ACCOUNT_ID=
ZOOM_API_URL=https://api.zoom.us/v2/
ZOOM_TIMEZONE=Asia/Kolkata
ZOOM_MEETING_PASSWORD=
Zoom_Account_User=
Zoom_mail=

# ------------------------------------------------------------------
# URL shortener (odrs.in)
# ------------------------------------------------------------------
ODRS_TOKEN=
ODRS_APP=P360MED
ODRS_HEADER=PRSOLV
ODRS_SHORTURL_URL=https://odrs.in/api/getshort

# ------------------------------------------------------------------
# Misc
# ------------------------------------------------------------------
PLATFORM_PREFIX=
NO_OF_REQUEST_SEND=

# ------------------------------------------------------------------
# Email template IDs (not secrets, but environment specific).
# See config/ and the Notification controllers for the full list:
#   EMAIL1_OF_VERIFY, EMAIL2_OF_FORGOTPASSWORD, EMAIL_L1,
#   L4_*, L5_*, L7_*, L8_*, L10_*, L13_*, L14_*, L15_*, L17_*,
#   L18_*, L19_*, L21_*, L23_*, L24_*  and their UK_ counterparts.
# ------------------------------------------------------------------
